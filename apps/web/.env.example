# ==============================================================================
# THE SEAFU PLATFORM — WEB FRONTEND (NUXT 3) ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting the web application.
# Note: Variables prefixed with NUXT_PUBLIC_ are exposed to the client-side browser!
# NEVER put secret keys (Stripe Secret Key, Supabase Service Role Key) here!
# ==============================================================================

# Backend API Endpoint
NUXT_PUBLIC_API_BASE="http://localhost:4000"

# Public App URLs
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Public Client (For direct client-side storage uploads if needed)
NUXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NUXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Razorpay Client Key (Only the Key ID, NEVER the Secret!)
NUXT_PUBLIC_RAZORPAY_KEY_ID=

# Stripe Client Publishable Key (Only the Publishable Key, NEVER the Secret Key!)
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Analytics / Monitoring (Optional)
NUXT_PUBLIC_SENTRY_DSN=""
NUXT_PUBLIC_GA_MEASUREMENT_ID=""
