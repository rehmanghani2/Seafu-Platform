datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SEAFARER
  INSTITUTE_ADMIN
  INSTITUTE_STAFF
  ADMIN
  SUPER_ADMIN
}

enum InstituteVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum CourseCategory {
  STCW_BASIC
  STCW_ADVANCED
  REFRESHER
  SIMULATOR
  OFFSHORE
  COMPETENCY
  VALUE_ADDED
}

enum CourseApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum BatchStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED_BY_CANDIDATE
  CANCELLED_BY_INSTITUTE
  COMPLETED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  INITIATED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DocumentType {
  PASSPORT
  CDC
  INDOS
  MEDICAL_FITNESS
  STCW_CERTIFICATE
  COC
  ACADEMIC
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum JobType {
  SHIPBOARD
  SHORE_BASED
}

enum JobApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  phone            String?
  role             UserRole        @default(SEAFARER)
  isActive         Boolean         @default(true)
  isEmailVerified  Boolean         @default(false)
  isPhoneVerified  Boolean         @default(false)
  
  // Profile info
  fullName         String
  indosNumber      String?
  cdcNumber        String?
  rank             String?
  nationality      String?
  avatarUrl        String?

  // Relations
  instituteId      String?
  institute        Institute?      @relation(fields: [instituteId], references: [id])
  bookings         Booking[]
  documents        Document[]
  certificates     Certificate[]
  jobApplications  JobApplication[]
  posts            CommunityPost[]
  comments         CommunityComment[]
  webinarRegistrations WebinarRegistration[]
  auditLogs        AuditLog[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([email])
  @@index([role])
}

model Institute {
  id                       String                      @id @default(uuid())
  name                     String
  slug                     String                      @unique
  dgShippingApprovalNumber String
  verificationStatus       InstituteVerificationStatus @default(PENDING)
  contactEmail             String
  contactPhone             String
  city                     String
  state                    String
  country                  String                      @default("India")
  address                  String
  websiteUrl               String?
  logoUrl                  String?
  commissionPercentage     Float                       @default(10.0)
  
  // Staff & Courses
  users                    User[]
  courses                  Course[]
  certificates             Certificate[]
  jobPosts                 JobPost[]
  webinars                 Webinar[]

  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([dgShippingApprovalNumber])
}

model Course {
  id               String               @id @default(uuid())
  instituteId      String
  institute        Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  title            String
  code             String
  slug             String
  description      String
  category         CourseCategory
  isDgApproved     Boolean              @default(true)
  approvalStatus   CourseApprovalStatus @default(PENDING_APPROVAL)
  durationDays     Int
  basePrice        Decimal              @db.Decimal(10, 2)
  currency         String               @default("INR")
  prerequisites    String[]             @default([])
  syllabus         String?

  batches          CourseBatch[]
  bookings         Booking[]

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([instituteId])
  @@index([category])
  @@index([approvalStatus])
}

model CourseBatch {
  id             String        @id @default(uuid())
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  totalSeats     Int
  availableSeats Int
  price          Decimal       @db.Decimal(10, 2)
  status         BatchStatus   @default(UPCOMING)

  bookings       Booking[]
  certificates   Certificate[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([courseId])
  @@index([startDate])
}

model Booking {
  id                  String               @id @default(uuid())
  bookingReference    String               @unique
  seafarerId          String
  seafarer            User                 @relation(fields: [seafarerId], references: [id])
  batchId             String
  batch               CourseBatch          @relation(fields: [batchId], references: [id])
  courseId            String
  course              Course               @relation(fields: [courseId], references: [id])
  
  amount              Decimal              @db.Decimal(10, 2)
  currency            String               @default("INR")
  status              BookingStatus        @default(PENDING_PAYMENT)
  studentInvoiceUrl   String?
  instituteInvoiceUrl String?

  transactions        PaymentTransaction[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([seafarerId])
  @@index([batchId])
  @@index([bookingReference])
}

model PaymentTransaction {
  id               String         @id @default(uuid())
  bookingId        String
  booking          Booking        @relation(fields: [bookingId], references: [id])
  gateway          PaymentGateway
  gatewayPaymentId String?
  gatewayOrderId   String?
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  status           PaymentStatus  @default(INITIATED)
  metadata         Json?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([bookingId])
}

model Document {
  id                 String                     @id @default(uuid())
  seafarerId         String
  seafarer           User                       @relation(fields: [seafarerId], references: [id], onDelete: Cascade)
  type               DocumentType
  documentNumber     String?
  issueDate          DateTime?
  expiryDate         DateTime?
  fileUrl            String
  fileName           String
  fileSize           Int
  mimeType           String
  verificationStatus DocumentVerificationStatus @default(PENDING)
  rejectionReason    String?

  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([seafarerId])
  @@index([type])
}

model Certificate {
  id                String      @id @default(uuid())
  instituteId       String
  institute         Institute   @relation(fields: [instituteId], references: [id])
  seafarerId        String
  seafarer          User        @relation(fields: [seafarerId], references: [id])
  batchId           String
  batch             CourseBatch @relation(fields: [batchId], references: [id])
  certificateNumber String      @unique
  qrCodeToken       String      @unique
  title             String
  issueDate         DateTime
  expiryDate        DateTime?
  pdfUrl            String
  isVerified        Boolean     @default(true)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([certificateNumber])
  @@index([qrCodeToken])
  @@index([seafarerId])
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
}

model JobPost {
  id               String           @id @default(uuid())
  instituteId      String?
  institute        Institute?       @relation(fields: [instituteId], references: [id])
  companyName      String
  title            String
  jobType          JobType          @default(SHIPBOARD)
  shipType         String?
  rank             String
  portOfJoining    String?
  salary           Decimal?         @db.Decimal(12, 2)
  currency         String           @default("USD")
  contractDuration String?
  description      String
  requirements     String[]         @default([])
  isPremium        Boolean          @default(false)
  postedBy         String
  status           JobStatus        @default(ACTIVE)
  expiresAt        DateTime

  applications     JobApplication[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([jobType])
  @@index([status])
  @@index([postedBy])
}

model JobApplication {
  id          String               @id @default(uuid())
  jobPostId   String
  jobPost     JobPost              @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  seafarerId  String
  seafarer    User                 @relation(fields: [seafarerId], references: [id], onDelete: Cascade)
  status      JobApplicationStatus @default(APPLIED)
  resumeUrl   String?
  coverNote   String?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([jobPostId])
  @@index([seafarerId])
}

model CommunityPost {
  id        String             @id @default(uuid())
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String             @default("GENERAL")
  upvotes   Int                @default(0)
  comments  CommunityComment[]

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([authorId])
}

model CommunityComment {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  upvotes   Int           @default(0)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
  @@index([authorId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
}

enum WebinarStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model Webinar {
  id               String                @id @default(uuid())
  instituteId      String
  institute        Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  title            String
  slug             String                @unique
  description      String
  category         String                @default("GENERAL") // NAVIGATION, ENGINEERING, MARITIME_LAW, SAFETY, OFFSHORE
  speakerName      String
  speakerTitle     String
  speakerBio       String?
  bannerUrl        String?
  streamUrl        String?
  scheduledAt      DateTime
  durationMinutes  Int                   @default(60)
  price            Decimal               @default(0.00) @db.Decimal(10, 2)
  isFree           Boolean               @default(true)
  maxAttendees     Int                   @default(250)
  status           WebinarStatus         @default(SCHEDULED)
  agenda           Json?

  registrations    WebinarRegistration[]

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([instituteId])
  @@index([category])
  @@index([status])
}

model WebinarRegistration {
  id               String         @id @default(uuid())
  webinarId        String
  webinar          Webinar        @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  seafarerId       String
  seafarer         User           @relation(fields: [seafarerId], references: [id], onDelete: Cascade)
  ticketCode       String         @unique
  qrCodeToken      String         @unique
  paymentStatus    PaymentStatus  @default(CAPTURED)
  attended         Boolean        @default(false)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([webinarId])
  @@index([seafarerId])
}

model Publication {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  description      String
  category         String         // DG_CIRCULARS, IMO_MODEL, SOLAS_MARPOL, EXAM_PREP, SIMULATOR_MANUALS
  author           String         @default("Directorate General of Shipping")
  documentUrl      String
  fileSize         String         @default("2.4 MB")
  isPublic         Boolean        @default(true)
  downloadsCount   Int            @default(0)
  publishedDate    DateTime       @default(now())

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([category])
}

