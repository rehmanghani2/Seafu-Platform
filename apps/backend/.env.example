# ==============================================================================
# THE SEAFU PLATFORM — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in the required credentials before starting.
# NEVER commit the real .env file with production secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,https://app.seafu.in"

# ------------------------------------------------------------------------------
# 2. DATABASE — POSTGRESQL (via Supabase)
# ------------------------------------------------------------------------------
# Transaction-pooled connection string (port 6543) - ideal for serverless / Prisma
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (port 5432) - required for Prisma migrations / DDL
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT (Session Security)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET="generate_a_strong_random_64_char_base64_string_for_access_token"
JWT_EXPIRES_IN="7d"

# Separate secret for Refresh Token rotation
JWT_REFRESH_SECRET="generate_a_different_strong_random_64_char_base64_string_for_refresh"
JWT_REFRESH_EXPIRES_IN="30d"

# Bcrypt salt rounds (10-12 recommended for production)
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. STORAGE & VAULT — SUPABASE STORAGE (S3-Compatible)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="seafarer-documents"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS (Dual Invoicing & Escrow)
# ------------------------------------------------------------------------------
# Razorpay (Domestic INR / UPI / NetBanking / Cards)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (International USD / EUR / Multi-Currency)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Platform Financial Rules
PLATFORM_COMMISSION_PERCENT=10
GST_RATE_PERCENT=18
TDS_RATE_PERCENT=1

# ------------------------------------------------------------------------------
# 6. PUSH NOTIFICATIONS — FIREBASE CLOUD MESSAGING (FCM)
# ------------------------------------------------------------------------------
# From Google Cloud / Firebase Console -> Service Accounts -> Generate Private Key
FIREBASE_PROJECT_ID="seafu-platform-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seafu-platform-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAILS (Booking confirmations, Tax Invoices, Expiry Alerts)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="resend"
SMTP_PASSWORD="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SMTP_FROM="The Seafu Authority <notifications@seafu.in>"
SUPPORT_EMAIL="support@seafu.in"

# ------------------------------------------------------------------------------
# 8. CRYPTOGRAPHIC AUTHORITY & ECDSA DOSSIER (DG Shipping Root)
# ------------------------------------------------------------------------------
# secp256k1 private key used to cryptographically sign STCW certificate QR hashes
DG_AUTHORITY_PRIVATE_KEY="0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
DG_AUTHORITY_PUBLIC_KEY="0x04xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
