PORT=4000
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage & Services
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-KEY]

# JWT Authentication
JWT_SECRET=seafu_super_secret_jwt_key_development_only
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=seafu_refresh_secret_key_development_only
JWT_REFRESH_EXPIRES_IN=30d

# Payment Gateways
RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=rzp_test_secret
STRIPE_SECRET_KEY=sk_test_key
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# Communications
SENDGRID_API_KEY=SG.test_key
SENDGRID_FROM_EMAIL=noreply@theseafu.com
MSG91_AUTH_KEY=test_msg91_key
